# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (Settings > API no dashboard). Veja o passo a passo
# completo no README.md.

# Project URL (Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# anon public key (Settings > API > Project API keys)
# Pode ficar exposta no front-end, é protegida pelas policies de RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key (Settings > API > Project API keys)
# NUNCA exponha no front-end. Usada só pelo script de seed (scripts/seed.mjs),
# que roda localmente/no servidor.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site, usada para gerar sitemap.xml, robots.txt e tags de SEO.
# Em produção, use o domínio real (sem "/" no final).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Opcional: só para rodar os testes end-to-end (npm run test:e2e) ---
# Credenciais de um usuário admin já criado no Supabase (ver passo 5 do README).
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
