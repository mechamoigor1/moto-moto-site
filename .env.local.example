# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Settings > API no dashboard do supabase.com).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Usada apenas pelo script de seed (scripts/seed.mjs), roda fora do Next.js.
# NUNCA exponha essa chave no browser nem em variáveis NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui
